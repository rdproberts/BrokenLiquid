/* BrokenLiquid - Light theme (default). Palette: Ink Navy #0E1A2B, Liquid Cyan #22C3E6,
   Mercury #C9D3DE, Signal Orange #FF7A3D, Steel #5B6B7F. */

QMainWindow::separator { background: #D5DDE6; width: 1px; height: 1px; }

QToolBar#QuickAccess {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FDFEFF, stop:1 #EEF2F6);
    border: none; border-bottom: 1px solid #D5DDE6; spacing: 2px; padding: 2px 6px;
}
QToolBar#CommandBarToolBar { background: #F7F9FB; border: none; border-bottom: 1px solid #C9D3DE; padding: 0; }

#CommandBarPages { background: #F7F9FB; }
QToolButton#CommandButton {
    color: #1B2633; font-size: 11px; padding: 3px 4px 2px 4px; border: 1px solid transparent; border-radius: 4px;
}
QToolButton#CommandButton:hover { background: #E3F6FB; border-color: #9EE2F2; }
QToolButton#CommandButton:pressed { background: #C9EEF8; }
QToolButton#CommandButton:disabled { color: #8795A6; }
QFrame#CommandBarSeparator { color: #D5DDE6; margin: 6px 3px; }

QTabBar#CommandBarTabs { background: #F7F9FB; }
QTabBar#CommandBarTabs::tab {
    padding: 3px 14px; margin: 0 1px 2px 0; border: 1px solid transparent; border-top: none;
    color: #3A4A5C; background: transparent;
}
QTabBar#CommandBarTabs::tab:selected {
    background: #FFFFFF; color: #0E1A2B; border-color: #C9D3DE; border-bottom: 2px solid #22C3E6;
}
QTabBar#CommandBarTabs::tab:hover:!selected { color: #0E1A2B; background: #EAF0F5; }

QLineEdit#CommandSearch {
    border: 1px solid #C9D3DE; border-radius: 12px; padding: 3px 10px; background: #FFFFFF;
    selection-background-color: #1E6FD9;
}
QLineEdit#CommandSearch:focus { border-color: #22C3E6; }

QDockWidget { border: none; }
QTabWidget#ManagerTabs::pane, QTabWidget#ResourcePane::pane { border: none; background: #FBFCFD; }
QTabWidget#ManagerTabs QTabBar::tab {
    padding: 5px 10px; background: transparent; border: none; border-bottom: 2px solid transparent;
}
QTabWidget#ManagerTabs QTabBar::tab:selected { border-bottom: 2px solid #22C3E6; background: #FBFCFD; }
QTabWidget#ResourcePane QTabBar::tab {
    padding: 8px 5px; background: #EEF1F4; border: none; border-left: 2px solid transparent;
}
QTabWidget#ResourcePane QTabBar::tab:selected { border-left: 2px solid #22C3E6; background: #FBFCFD; }

QTreeWidget#FeatureTree, QTreeView { border: none; background: #FBFCFD; }
QTreeWidget#FeatureTree::item { padding: 2px 0; }
QTreeWidget#FeatureTree::item:hover, QTreeView::item:hover { background: #E3F6FB; }
QTreeWidget#FeatureTree::item:selected, QTreeView::item:selected { background: #CFE3FA; color: #0E1A2B; }

QLabel#PaneTitle { color: #0E1A2B; font-size: 13px; }
QLabel#PaneHint { color: #5B6B7F; }

QStatusBar { background: #EEF1F4; border-top: 1px solid #D5DDE6; color: #3A4A5C; }
QStatusBar QLabel { padding: 0 8px; color: #3A4A5C; }
QLabel#StatusState { color: #5B6B7F; }

QToolButton#HudButton { border: 1px solid transparent; border-radius: 4px; padding: 2px; }
QToolButton#HudButton:hover { background: rgba(34, 195, 230, 40); border-color: rgba(34, 195, 230, 120); }
QFrame#HudSeparator { color: rgba(31, 58, 90, 60); }

QMenu { background: #FFFFFF; border: 1px solid #C9D3DE; padding: 4px 0; }
QMenu::item { padding: 5px 28px 5px 26px; }
QMenu::item:selected { background: #E3F6FB; color: #0E1A2B; }
QMenu::item:disabled { color: #9AA7B6; }
QMenu::separator { height: 1px; background: #E1E7ED; margin: 4px 8px; }
QToolTip { background: #FFFFFF; color: #1B2633; border: 1px solid #C9D3DE; padding: 4px 6px; }

/* --- Phase 1: Property Panel, Confirm Corner, document tabs, Home ----------------------------- */
QWidget#PropertyPanel, QScrollArea#PanelScroll, QScrollArea#PanelScroll > QWidget > QWidget { background: #FBFCFD; }
QLabel#PanelTitle { color: #0E1A2B; font-size: 14px; font-weight: 600; }
QToolButton#PanelOk, QToolButton#PanelCancel {
    font-size: 15px; border: 1px solid transparent; border-radius: 4px; min-width: 26px; min-height: 24px;
}
QToolButton#PanelOk { color: #1B8A3A; }
QToolButton#PanelCancel { color: #C0392B; }
QToolButton#PanelOk:hover, QToolButton#PanelCancel:hover { background: #E3F6FB; border-color: #9EE2F2; }
QLabel#PanelMessage {
    background: #FFF7E8; border: 1px solid #F5D9A8; border-radius: 4px; padding: 6px 8px; color: #4A3B1F;
}
QFrame#PanelGroup { background: #FFFFFF; border: 1px solid #DCE3EA; border-radius: 5px; }
QToolButton#PanelGroupHeader { font-weight: 600; color: #1B2633; border: none; padding: 4px 2px; background: transparent; }
QListWidget#SelectionBox { border: 1px solid #C9D3DE; border-radius: 3px; background: #FFFFFF; }
QListWidget#SelectionBox[active="true"] { border: 2px solid #22C3E6; background: #F2FBFE; }
QListWidget#SelectionBox::item:selected { background: #CFE3FA; color: #0E1A2B; }
QLineEdit#LengthField { border: 1px solid #C9D3DE; border-radius: 3px; padding: 2px 6px; background: #FFFFFF; }
QLineEdit#LengthField:focus { border-color: #22C3E6; }
QLineEdit#LengthField[invalid="true"] { border: 2px solid #D64545; background: #FFF1F1; }

QToolButton#CornerOk, QToolButton#CornerCancel { font-size: 18px; border: 1px solid transparent; border-radius: 4px; }
QToolButton#CornerOk { color: #1B8A3A; }
QToolButton#CornerCancel { color: #C0392B; }
QToolButton#CornerOk:hover, QToolButton#CornerCancel:hover { background: #E3F6FB; border-color: #9EE2F2; }

QTabWidget#DocumentTabs::pane { border: none; }
QTabWidget#DocumentTabs QTabBar::tab {
    padding: 4px 12px; background: #EEF1F4; border: 1px solid #D5DDE6; border-bottom: none; margin-right: 1px;
    color: #3A4A5C;
}
QTabWidget#DocumentTabs QTabBar::tab:selected { background: #FFFFFF; color: #0E1A2B; border-top: 2px solid #22C3E6; }

QWidget#HomeContent { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #EEF3F8); }
QLabel#HomeTitle { color: #0E1A2B; font-size: 30px; font-weight: 300; }
QLabel#HomeSubtitle { color: #5B6B7F; font-size: 13px; }
QFrame#HomeCard { background: #FFFFFF; border: 1px solid #DCE3EA; border-radius: 8px; }
QFrame#HomeCardAccent { background: #F2FBFE; border: 1px solid #9EE2F2; border-left: 4px solid #22C3E6; border-radius: 8px; }
QLabel#HomeCardTitle { color: #0E1A2B; font-size: 14px; font-weight: 600; }
QToolButton#HomeAction {
    background: #FFFFFF; border: 1px solid #DCE3EA; border-radius: 8px; padding: 10px; color: #1B2633; font-size: 12px;
}
QToolButton#HomeAction:hover { background: #E3F6FB; border-color: #22C3E6; }
QToolButton#HomeAction:disabled { color: #9AA7B6; background: #F5F7F9; }
QToolButton#HomeRecent { text-align: left; padding: 4px 6px; border-radius: 4px; color: #1B2633; }
QToolButton#HomeRecent:hover { background: #E3F6FB; }
QPushButton#HomePrimary {
    background: #22C3E6; color: #0E1A2B; border: none; border-radius: 4px; padding: 6px 18px; font-weight: 600;
}
QPushButton#HomePrimary:hover { background: #4FD2EE; }
QToolButton#StatusUnits { padding: 0 8px; border: none; color: #3A4A5C; }
QToolButton#StatusUnits:hover { background: #E3F6FB; }
